# Etapa 1: compilar MinIO desde el codigo fuente
FROM golang:1.24.8-bookworm AS builder

ARG MINIO_COMMIT=7aac2a2c5b7c882e68c1ce017d8256be2feea27f

WORKDIR /src

# Descargar exactamente el commit comprobado
RUN git init . \
    && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth=1 origin "${MINIO_COMMIT}" \
    && git checkout --detach FETCH_HEAD

# Compilar para Linux sin dependencias CGO
RUN CGO_ENABLED=0 go build -trimpath -o /out/minio .

# Etapa 2: imagen de ejecucion
FROM debian:bookworm-slim

# Crear usuario sin privilegios y directorio de datos
RUN groupadd --gid 10001 minio \
    && useradd --uid 10001 --gid 10001 \
       --no-create-home minio \
    && mkdir -p /data \
    && chown minio:minio /data

COPY --from=builder /out/minio /usr/local/bin/minio

USER minio

EXPOSE 9000 9001

ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
